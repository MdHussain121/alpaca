│                                                                                                                                                              │
│ Assistant  42.5 t/s · 64 tok                                                                                                                                 │
│   ▾ Thought for 1.4s · 18 tok                                                                                                                     [ctrl+t]   │
│     │ Need iterative O(n) loop.                                                                                                                              │
│     │ Avoid exponential recursion.                                                                                                                           │
│   Iterative Go Implementation                                                                                                                                │
│                                                                                                                                                              │
│   Here is a constant-space version:                                                                                                                          │
│                                                                                                                                                              │
│   ╭─ go ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────── [c] copy ─╮ │
│   │  1 │ package mathutil                                                                                                                                  │ │
│   │  2 │                                                                                                                                                   │ │
│   │  3 │ // Fib returns the n-th Fibonacci number in O(n) time and O(1) space.                                                                             │ │
│   │  4 │ func Fib(n int) int {                                                                                                                             │ │
│   │  5 │     if n < 2 {                                                                                                                                    │ │
│   │  6 │         return n                                                                                                                                  │ │
│   │  7 │     }                                                                                                                                             │ │
│   │  8 │     a, b := 0, 1                                                                                                                                  │ │
│   │  9 │     for i := 2; i <= n; i++ {                                                                                                                     │ │
│   │ 10 │         a, b = b, a+b                                                                                                                             │ │
│   │ 11 │     }                                                                                                                                             │ │
│   │ 12 │     return b                                                                                                                                      │ │
│   │ 13 │ }                                                                                                                                                 │ │
│   ╰────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯ │
│                                                                                                                                                              │
│   • Time: O(n) using a, b = b, a+b.                                                                                                                          │
